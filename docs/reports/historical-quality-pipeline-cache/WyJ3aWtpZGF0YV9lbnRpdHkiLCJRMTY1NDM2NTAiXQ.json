  "descriptions": {
    "es": {
      "language": "es",
      "value": "posición de la mujer en la organización social (hogar y familia, trabajo, política, instituciones sociales), y diferencias de tratamiento y de participación entre hombres y mujeres"
    },
    "it": {
      "language": "it",
      "value": "complesso di norme, costumi e visioni del mondo che riguardano il ruolo della donna nella società"
    },
    "fr": {
      "language": "fr",
      "value": "position des femmes dans l'organisation sociale"
    }
  },
