  "descriptions": {
    "de": {
      "language": "de",
      "value": "Abgrenzung der Befugnisse und Verantwortlichkeiten zwischen der deutschen Bundesregierung und der Alliierten Hohen Kommission"
    },
    "en": {
      "language": "en",
      "value": "regulated the division of powers and responsibilities between the German federal government and the Allied High Commission"
    },
    "fr": {
      "language": "fr",
      "value": "réglementé la répartition des pouvoirs et des responsabilités entre le gouvernement allemand et la Haute Commission Alliée"
    },
    "nl": {
      "language": "nl",
      "value": "statuten van geallieerden"
    },
    "nb": {
      "language": "nb",
      "value": "av 10. mai 1949"
    },
    "ja": {
      "language": "ja",
      "value": "占領下ドイツ政府と西ドイツの連合高等弁務官の責任と役割について定めた法"
    },
    "sv": {
      "language": "sv",
      "value": "stadga för relationen mellan Västtyskland och ockupationsmakterna 1949–1955"
    },
    "ar": {
      "language": "ar",
      "value": "قانون وضعته دول الحلفاء لتحديد أدوار الحكومة الألمانية المنشأة حديثاً"
    },
    "es": {
      "language": "es",
