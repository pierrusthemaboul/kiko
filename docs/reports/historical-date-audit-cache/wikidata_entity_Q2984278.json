    "descriptions": {
      "fr": {
        "language": "fr",
        "value": "histoire de l'occupation du territoire actuel du Congo Kinshasa par les Européens depuis le XVIe siècle jusqu'en 1960"
      },
      "en": {
        "language": "en",
        "value": "European colonization of Africa's Congo Basin"
      },
      "ln": {
        "language": "ln",
        "value": "lisolo ya congo na tango ezalaki nasé ya bowumbu yaba mindele na mibu mileka pona ko konza mboka congo"
      },
      "lua": {
        "language": "lua",
        "value": "Dikokesha dia ditunga dia Congo diakenzeka mu tshikondo tshia kumbukila ku dikebulula dia kumpala dia ditunga dia Congo-Kinshasa kudi Henry Morton Stanley (1867) too ne ku dikuata dia ditunga kudi Mukalenge Léopold II wa mu Belgique (1885)."
      }
