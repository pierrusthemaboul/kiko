    "descriptions": {
      "de": {
        "language": "de",
        "value": "mittelalterlicher Bauernaufstand"
      },
      "en": {
        "language": "en",
        "value": "French peasant uprising, 1358"
      },
      "it": {
        "language": "it",
        "value": "insurrezione popolare"
      },
      "ru": {
        "language": "ru",
        "value": "название крестьянского восстания во Франции в 1358 году"
      },
      "eo": {
        "language": "eo",
        "value": "kamparana ribelo en Francio en 1358"
      },
      "fr": {
        "language": "fr",
        "value": "soulèvement de paysans des campagnes d'Île-de-France, de Picardie, de Champagne, d'Artois et de Normandie, survenu au cours de la guerre de Cent Ans, dans un contexte de crise du royaume de France"
      },
      "ja": {
        "language": "ja",
        "value": "1358年に百年戦争中のフランスで起こった大規模な農民反乱"
      },
      "ca": {
        "language": "ca",
        "value": "una revolta camperola de l'Edat Mitjana al Regne de França l'any 1358 durant la Guerra dels Cent Anys"
      },
      "es": {
        "language": "es",
        "value": "revuelta campesina de la Edad Media que tuvo lugar en el norte de Francia en 1358 durante la Guerra de los Cien Años"
      },
      "ko": {
        "language": "ko",
        "value": "백년전쟁 와중이던 1358년 여름, 프랑스 북부에서 발생한 농민 반란"
      },
      "pt": {
        "language": "pt",
        "value": "uma revolta camponesa que ocorreu em 1358 em diversas regiões do norte da França"
      },
      "nl": {
        "language": "nl",
        "value": "een opstand tegen de adel van de Franse boeren in mei 1358"
      },
      "pcd": {
        "language": "pcd",
        "value": "un soulèvmint poaiyisan qu’o ieu liu in 1358 dins ches campannes d’Ile-ed-Franche, d’Picardie, d’Champanne, d’Artoés pi d’Neurmindie"
      },
      "ro": {
        "language": "ro",
        "value": "mișcare socială"
      },
      "gl": {
        "language": "gl",
        "value": "unha revolta campesiña que ocorreu no norte de Francia entre o 28 de maio e o 24 de xuño de 1358, durante a Guerra dos Cen Anos"
      },
      "sv": {
        "language": "sv",
        "value": "en bonderesning som ägde rum i norra Frankrike under hundraårskriget 1358"
      },
      "uz": {
        "language": "uz",
        "value": "Fransiyada 1358-yil mulkdorlarga qarshi koʻtarilgan dehqonlar qoʻzgʻoloni"
      },
      "hu": {
        "language": "hu",
        "value": "1358-as francia parasztfelkelés"
      }
