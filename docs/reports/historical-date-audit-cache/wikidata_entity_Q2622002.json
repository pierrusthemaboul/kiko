    "descriptions": {
      "eo": {
        "language": "eo",
        "value": "la evento, dum la Franca revolucio de 1789, kiam feŭdismo estis abolita"
      },
      "en": {
        "language": "en",
        "value": "1789 abolition of the feudal system in French feudal system by the Constituent Assembly; one of the central events of the French Revolution"
      },
      "es": {
        "language": "es",
        "value": "sesión de la Asamblea Nacional Constituyente francesa en la que se votó la supresión de los privilegios feudales"
      },
      "fr": {
        "language": "fr",
        "value": "séance de l'Assemblée nationale constituante française, au cours de laquelle fut votée la suppression des privilèges féodaux"
      },
      "de": {
        "language": "de",
        "value": "Sitzung der französischen Verfassungsgebenden Nationalversammlung, auf der über die Abschaffung der feudalen Privilegien abgestimmt wurde"
      },
      "ar": {
        "language": "ar",
        "value": "دورة الجمعية التأسيسية الوطنية الفرنسية حيث تم التصويت على إلغاء الامتيازات الإقطاعية"
      },
      "he": {
        "language": "he",
        "value": "מושב האסיפה הלאומית של צרפת, שבו נבחרה ביטול החובות הפיאודליים"
      },
      "ja": {
        "language": "ja",
        "value": "フランス国民構成会議で、封建特権の廃止が投票された"
      },
      "pt": {
        "language": "pt",
        "value": "sessão da Assembleia Nacional Constituinte Francesa, onde foi votada a supressão dos privilégios feudais"
      },
      "ru": {
        "language": "ru",
        "value": "сессии Национального учредительного собрания Франции, на которой было принято решение об отмене феодальных привилегий"
      },
      "zh": {
        "language": "zh",
        "value": "法国国民制宪会议上表决废除封建特权"
      },
      "br": {
