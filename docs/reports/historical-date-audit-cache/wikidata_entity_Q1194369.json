    "descriptions": {
      "en": {
        "language": "en",
        "value": "first successful, documented attainment of the top of a mountain, or specific route"
      },
      "fr": {
        "language": "fr",
        "value": "première expédition atteignant le sommet d'une montagne ou première ascension empruntant une voie spécifique"
      },
      "sl": {
        "language": "sl",
        "value": "prvi uspešen dokumentiran vzpon na vrh gore"
      },
      "sv": {
        "language": "sv",
        "value": "första lyckade och dokumenterade bestigningen av ett berg, eller en specifik rutt som bestigits"
      },
      "bn": {
        "language": "bn",
        "value": "প্রথমবার সফলতম, একটি পর্বতের উপরে বা নির্দিষ্ট রুটে চড়াইয়ের নথিভুক্ত উপলব্ধি"
      },
      "zh-hans": {
