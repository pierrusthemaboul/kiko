    "descriptions": {
      "en": {
        "language": "en",
        "value": "conflict in the Holy Roman Empire between the Prince-Bishopric of Liège under Bishop John of Enghien and the Marquisate of Namur under Marquis Guy of Dampierre, beginning as a dispute over stolen property"
      },
      "eo": {
        "language": "eo",
        "value": "milito en la Sankta Romia Imperio (1275–1278)"
      },
      "fr": {
        "language": "fr",
        "value": "conflit de 1275 à 1280 sur le territoire de l’actuelle Belgique"
      },
      "wa": {
        "language": "wa",
        "value": "guere di 1275 a 1278 inte li principåté d' Lidje et l' dutcheye di Nameur (les deus estant e minme Sint Impire Romin Djermanike) a cåze d' ene vatche"
      }
    },
