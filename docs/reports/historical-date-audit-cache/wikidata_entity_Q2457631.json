    "descriptions": {
      "uk": {
        "language": "uk",
        "value": "Скандальний християнсько-мусульманський союз між королівством Францію і Оттоманською імперією"
      },
      "en": {
        "language": "en",
        "value": "alliance between the Kingdom of France and the Ottoman Empire"
      },
      "de": {
        "language": "de",
        "value": "historisch-politische Beziehungen zwischen Frankreich und dem Osmanischen Reich"
      },
      "it": {
        "language": "it",
        "value": "alleanza tra il Regno di Francia e l'Impero ottomano (1536-1791)"
      },
      "ar": {
        "language": "ar",
        "value": "التحالف الفرنسي العثماني، والذي يعرف أيضًا التحالف الفرنسي التركي، هو تحالف بدأ عام 1536 بين ملك فرنسا فرانسوا الأول والسلطان العثماني سليمان القانوني، وهو التحالف الذي قيل عنه أنه «أول تحالف غير أيديولوجي دبلوماسي من نوعه بين إمبراطوريتين مسيحية"
      },
      "az": {
        "language": "az",
        "value": "Fransa Krallığı ilə Osmanlı imperiyası arasında Habsburqlara qarşı birgə ittifaq"
      },
      "tr": {
        "language": "tr",
        "value": "Tarih Yazılısı"
      },
      "ru": {
        "language": "ru",
        "value": "Беспрецедентный союз между Королевством Франция и Османской империей"
      },
      "fr": {
        "language": "fr",
        "value": "Traité d'alliance entre l'Empire ottoman et le Royaume de France"
      },
      "es": {
