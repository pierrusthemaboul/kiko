    "descriptions": {
      "en": {
        "language": "en",
        "value": "document providing a legal basis for the erection of the Papal States, which extended the temporal rule of the Popes beyond the duchy of Rome"
      },
      "fr": {
        "language": "fr",
        "value": "traité de Quierzy (754) entre Pépin le Bref et le pape Étienne II favorisant la création des États pontificaux"
      },
      "id": {
        "language": "id",
        "value": "dokumen yang menjadi dasar hukum pembentukan Negara Gereja, yang meluaskan kuasa temporal Sri Paus melampaui sempadan Kadipaten Roma."
      },
      "pt": {
        "language": "pt",
        "value": "documento que fornece uma base jurídica para a criação dos Estados Papais, que estendeu o governo temporal dos Papas para além do ducado de Roma"
      },
      "ja": {
        "language": "ja",
        "value": "756年にフランク王ピピン3世がローマ教皇にラヴェンナ地方を寄進した出来事"
      },
      "ru": {
        "language": "ru",
        "value": "исторический документ"
      },
      "it": {
        "language": "it",
        "value": "documento del 754"
      }
