    "descriptions": {
      "en": {
        "language": "en",
        "value": "1561 conference between Catholics and Protestants (Huguenots) in Poissy, France"
      },
      "hy": {
        "language": "hy",
        "value": "եկեղեցական խորհրդակցություն, որը տեղի էր ունեցել 1561 թվականի սեպտեմբերի 9-ից հոկտեմբերի 14-ը Սենտ Լուի դը Պուասի վանահայրությունում"
      }
    },
