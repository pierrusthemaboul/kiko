    "descriptions": {
      "it": {
        "language": "it",
        "value": "trattato tra governo francese e il Governo provvisorio della Repubblica algerina"
      },
      "en": {
        "language": "en",
        "value": "treaty signed by France and the Provisional Government of the Algerian Republic to end the Algerian War"
      },
      "ru": {
        "language": "ru",
        "value": "соглашения, заключённые между Францией и Алжиром в 1962 году. положили конец Алжирской войне"
      },
      "nl": {
        "language": "nl",
        "value": "Verdrag tussen Frankrijk en Algerije, einde van de Algerijnse oorlog"
      },
      "ar": {
        "language": "ar",
        "value": "مفاوضات طويلة جرت في 18 مارس 1962 بين القادة الوطنيين الجزائريين وبين الموفد الفرنسي"
      },
      "de": {
        "language": "de",
        "value": "Vertrag zwischen Frankreich und der algerischen Nationalen Befreiungsfront zur Beendigung des Algerienkrieges."
      },
      "he": {
        "language": "he",
        "value": "אמנה שנחתמה בין צרפת והחזית הלאומית לשחרור אלג'יריה והביאה לסיום מלחמת העצמאות של אלג'יריה ב-18 במרץ 1962"
      },
      "fr": {
        "language": "fr",
        "value": "accords signés entre les représentants du Gouvernement de la République française et du Gouvernement provisoire de la République algérienne pour mettre fin à la guerre d'Algérie"
      },
      "tg": {
        "language": "tg",
        "value": "созишномаҳое, ки байни Фаронса ва Алҷазоир имзо шуда буданд, ва ба ҷанги Алҷазоир хотима бахшиданд (с. 1962)"
      },
      "tg-latn": {
        "language": "tg-latn",
        "value": "sozishnomahoe, ki bayni Faronsa va Aljazoir imzo shuda budand, va ba jangi Aljazoir xotima baxshidand (s. 1962)"
      },
      "ca": {
        "language": "ca",
        "value": "acords entre representants del govern francès i del govern provisional algerià per posar fi a la guerra d'Algèria i pels quals aquest estat és reconegut"
      },
      "sl": {
        "language": "sl",
        "value": "pogodba med Francijo in Alžirsko narodnoosvobodilno fronto o koncu alžirske vojne (1962)"
      },
      "es": {
        "language": "es",
        "value": "tratado de paz entre Francia y Argelia"
      },
      "ja": {
        "language": "ja",
        "value": "フランスがアルジェリアの独立を承認した協定"
      }
    },
