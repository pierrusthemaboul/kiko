    "descriptions": {
      "en": {
        "language": "en",
        "value": "series of 3 alliances (1773, 1743, 1761) between the Bourbon kings of France and Spain"
      },
      "eo": {
        "language": "eo",
        "value": "serio da tri aliancoj (1773, 1743, 1761) inter Francio kaj Hispanio"
      },
      "pt": {
        "language": "pt",
        "value": "Aliança entre os reis franceses e espanhóis de diferentes ramos da Casa de Bourbon"
      },
      "es": {
        "language": "es",
        "value": "tres alianzas (1733, 1743, 1761) entre las monarquías borbonicas de Francia y España contra Gran Bretaña"
      },
      "it": {
        "language": "it",
        "value": "alleanza del XVIII secolo tra Francia e Spagna, sulle quali all'epoca regnavano i Borbone"
      }
