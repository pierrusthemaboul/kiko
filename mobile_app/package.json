{
  "name": "timalaus-mobile",
  "main": "index.js",
  "version": "1.7.4",
  "_comment": "📚 Documentation importante : Avant de modifier l'audio, lisez /docs/AUDIO_MIGRATION_GUIDE.md",
  "scripts": {
    "dev": "expo start --clear --max-workers 4",
    "dev:fast": "expo start --max-workers 4 --localhost",
    "start": "expo start",
    "prebuild:check": "node ../scripts/mobile_app/prebuild-checker.js",
    "typecheck:app": "tsc -p tsconfig.check.json --noEmit",
    "reset-project": "node ../scripts/mobile_app/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint": "expo lint",
    "postinstall": "patch-package",
    "eas-build-post-install": "node ./scripts/eas-build-post-install.js",
    "android:fix-manifest": "node ../scripts/mobile_app/fix-manifest.js",
    "android:fix-kotlin": "node ../scripts/mobile_app/fix-kotlin-version.js",
    "prebuild:clean": "expo prebuild --platform android --clean",
    "prebuild:android": "npx expo prebuild --platform android --clean",
    "build:android:local": "eas build --platform android --profile production --local",
    "build:android:cloud": "eas build --platform android --profile production --clear-cache",
    "build:android:production": "npm run prebuild:android && eas build --platform android --profile production --clear-cache",
    "start:usb": "adb reverse tcp:8081 tcp:8081 && npx expo start --localhost --android"
  },
