{
  "cli": {
    "version": ">=7.6.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "development"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      }
    },
    "dev": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "development"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": false,
      "credentialsSource": "remote",
      "node": "20.19.4",
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "internalTesting",
        "EXPO_SKIP_DOCTOR": "1"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": true
      }
    },
    "simulator": {
      "distribution": "internal",
      "autoIncrement": false,
      "credentialsSource": "remote",
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "production",
        "EXPO_SKIP_DOCTOR": "1"
      },
      "ios": {
        "simulator": true
      }
    },
    "apk": {
      "distribution": "internal",
      "autoIncrement": false,
      "credentialsSource": "remote",
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "apkTesting",
        "EXPO_SKIP_DOCTOR": "1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": false,
      "credentialsSource": "remote",
      "node": "20.19.4",
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "production",
        "EXPO_SKIP_DOCTOR": "1"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "distribution": "store",
        "image": "latest"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "production",
        "releaseStatus": "completed",
        "serviceAccountKeyPath": "./kiko-chrono-e34241a84e41.json"
      },
      "ios": {
        "appleId": "pierre.cousin7@gmail.com",
        "ascAppId": "6762569723",
        "appleTeamId": "RBH23M8YUV"
      }
    }
  }
}