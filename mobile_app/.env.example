# ==========================================
# VARIABLES D'ENVIRONNEMENT - Kiko/Timalaus
# ==========================================
# Copie ce fichier en .env et remplis les valeurs

# ==========================================
# SUPABASE (OBLIGATOIRE)
# ==========================================
# URL de ton projet Supabase
EXPO_PUBLIC_SUPABASE_URL=https://ton-projet.supabase.co

# Clé anonyme (anon key) - Pour l'app cliente
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clé service role - Pour les scripts serveur (SENSIBLE - NE PAS PARTAGER)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Alternative pour certains scripts
SUPABASE_URL=${EXPO_PUBLIC_SUPABASE_URL}
SUPABASE_ANON_KEY=${EXPO_PUBLIC_SUPABASE_ANON_KEY}
SUPABASE_SERVICE_KEY=${SUPABASE_SERVICE_ROLE_KEY}

# ==========================================
# GOOGLE SERVICES (OBLIGATOIRE pour Firebase)
# ==========================================
# Chemin vers le fichier google-services.json
GOOGLE_SERVICES_JSON=./google-services.json

# ==========================================
# APIS IA (OPTIONNEL - pour génération de contenu)
# ==========================================
# API Gemini (Google)
GEMINI_API_KEY=

# API OpenAI (pour illustrations)
OPENAI_API_KEY=

# API Replicate (pour génération d'images)
REPLICATE_API_TOKEN=

# ==========================================
# ENVIRONNEMENT
# ==========================================
# Variant de l'app : "development" ou "production"
EXPO_PUBLIC_APP_VARIANT=development

# Node environment
NODE_ENV=development
